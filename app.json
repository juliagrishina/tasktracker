{
  "expo": {
    "name": "TaskTracker",
    "slug": "tasktracker",
    "version": "1.0.0",
    "icon": "./assets/plan-my-plan-512.png",
    "orientation": "portrait",
    "scheme": "tasktracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/plan-my-plan-512.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/favicon.png",
      "name": "Plan My Plan",
      "shortName": "Plan My Plan",
      "lang": "ru",
      "display": "standalone",
      "startUrl": "/",
      "themeColor": "#061E42",
      "backgroundColor": "#061E42"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-notifications",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
